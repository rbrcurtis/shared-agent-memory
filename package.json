{
  "name": "shared-agent-memory",
  "version": "0.2.8",
  "description": "MCP server for shared AI agent memory via the Memory API",
  "main": "dist/index.js",
  "bin": {
    "shared-agent-memory": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts src/hooks/memory-turn-hook.ts --bundle --platform=node --format=esm --outdir=dist --outbase=src --target=node18 --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:api": "node dist/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "mcp",
    "qdrant",
    "ai",
    "memory",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@modelcontextprotocol/sdk": "^0.4.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "@xenova/transformers": "^2.17.2",
    "arg": "^5.0.2",
    "fastify": "^5.8.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
